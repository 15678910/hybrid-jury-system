# ============================================================
# functions/.env.example
#
# 이 파일을 복사해서 functions/.env 를 만든 뒤 실제 값을 채운다.
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# ⚠️ functions/.env 는 절대 커밋하지 않는다. (.gitignore 로 차단돼 있음)
# ⚠️ 실제 키를 이 파일(.env.example)에 적지 않는다. 여기는 자리표시자만.
#
# Firebase Functions 는 배포 시 functions/.env 를 자동으로 읽는다.
# 로컬 스크립트(probe_judicial_api.cjs 등)도 같은 파일을 읽는다.
# ============================================================

# ── AI ────────────────────────────────────────────────────
# Google Gemini API (서버 전용)
# ※ 2026-06-06 크레딧 소진으로 뉴스 요약은 AI 없이 동작 중
GOOGLE_API_KEY=your-gemini-api-key-here

# ── 텔레그램 봇 ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_GROUP_CHAT_ID=-1000000000000

# ── 관리자 인증 ────────────────────────────────────────────
ADMIN_SECRET_KEY=your-admin-secret-key-here
ACCESS_ADMIN_CODE=your-admin-access-code-here
ACCESS_WRITER_CODE=your-writer-access-code-here

# ── 인스타그램 릴스 게시 (동영상 페이지 인스타 아이콘, 관리자 전용) ──
# Meta 앱 「시민법정 인스타 게시」(Instagram API with Instagram Login)의 장기 토큰(60일)과 계정 ID(숫자).
# 처음 한 번만 쓰인다: 함수가 첫 실행 때 이 값을 Firestore instagramAuth/current 로 옮겨 적고, 그 뒤로는
# refreshInstagramToken 이 매주 자동 연장한다. 토큰이 죽으면 동영상 페이지에서 새 토큰을 붙여 넣는다(재배포 불필요).
# 절차: docs/instagram/README.md
IG_ACCESS_TOKEN=your-instagram-long-lived-token-here
IG_USER_ID=00000000000000000

# ── 카카오 ────────────────────────────────────────────────
KAKAO_APP_KEY=your-kakao-app-key-here

# ── 네이버 검색 API (개혁안 뉴스 자동수집, 무료 하루 25k) ──
# https://developers.naver.com → 애플리케이션 등록 → 검색 API
NAVER_CLIENT_ID=your-naver-client-id-here
NAVER_CLIENT_SECRET=your-naver-client-secret-here

# ── 크론 트리거 토큰 ───────────────────────────────────────
# GitHub Actions 에서 collectReformNewsCron 호출 시 x-cron-key 헤더로 사용
# ※ GitHub 저장소 Secret 에도 동일한 값을 등록해야 한다
CRON_TOKEN=your-long-random-token-here

# ── 법제처 국가법령정보 OPEN API ───────────────────────────
# https://open.law.go.kr → 이메일 ID(OC 값)
LAWAPI_OC=your-law-go-kr-oc-here

# ── 법원 API ──────────────────────────────────────────────
COURT_API_KEY=your-court-api-key-here

# ── 공공데이터포털 — 사법연감정보조회서비스 ────────────────
# https://www.data.go.kr/data/15140048/openapi.do
# 제공: 한국형사법무정책연구원 / 원자료: 법원행정처 사법연감
#
# ⚠️ 반드시 「일반 인증키(Decoding)」를 넣는다.
#    Encoding 키를 넣으면 이중 인코딩으로
#    SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 발생한다.
#
# 사용처: functions/probe_judicial_api.cjs (응답 구조 탐침)
#         향후 collectJudicialStats (기저율 자동 수집)
DATA_GO_KR_KEY=your-data-go-kr-decoding-key-here
